# RED System Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=63.0.0
NEXT_PUBLIC_API_URL=http://localhost:7333

# Rust Backend
RUST_LOG=red_core=debug,red_mobile=debug,axum=info
RUST_BACKTRACE=1

# Database
SLED_DB_PATH=./data/sled
SLED_CACHE_CAPACITY=1000000

# Cryptography
CRYPTO_MASTER_PIN_LENGTH=6
CRYPTO_ARGON2_M_COST=65536
CRYPTO_ARGON2_T_COST=3
CRYPTO_ARGON2_PARALLELISM=4

# Networking
AXUM_BIND_ADDR=127.0.0.1
AXUM_BIND_PORT=7333
MESH_TTL_MAX=64
DTN_RETENTION_HOURS=48

# Security
X_API_KEY_SEED=your-secure-random-seed-here
BIOAUTH_TIMEOUT_SECONDS=5
PANIC_PIN=000000
DECOY_PIN=111111

# Biometric
BIOMETRIC_ENABLED=true
BIOMETRIC_TIMEOUT_MS=30000

# AI/ML
AI_MODEL_PATH=./models/lamini-flan-t5
AI_ENABLE_RAG=true
AI_ENABLE_GUARDIAN=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# Testing
TEST_MODE=false
TEST_SKIP_BIOMETRIC=false
